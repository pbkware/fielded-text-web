{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "plugin": [],
  "exclude": ["**/node_modules/**", "**/*.test.ts", "**/tests/**"],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "readme": "README.md",
  "name": "FieldedText TypeScript Library",
  "includeVersion": true,
  "categorizeByGroup": true,
  "categoryOrder": ["Core", "Metadata", "Serialization", "Meta Serialization", "Factories", "Fields", "Sequences", "Event Args", "Enums", "*"],
  "sort": ["source-order"],
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "visibilityFilters": {
    "protected": false,
    "private": false,
    "inherited": true,
    "external": false
  },
  "searchInComments": true,
  "searchInDocuments": true
}
