{
  "$schema": "https://typedoc.org/schema.json",
  // "entryPoints": ["../node/src", "../web/src"],
  "entryPoints": ["../web", "../node"],
  "sort": ["documents-first"],
  // "sortEntryPoints": false,
  "name": "FieldedText TypeScript Library",
  "entryPointStrategy": "packages",
  "out": "./dist",
  "router": "structure-dir",
  "highlightLanguages": ["typescript", "xml", "bash", "json", "csv", "text"],
  "readme": "../README.md",
  "projectDocuments": ["change-log.md"],
  "favicon": "../web/src-docs/favicon.svg",
  "cleanOutputDir": true,
  "githubPages": true,
  "hideGenerator": true,
  "searchInComments": true,
  "searchInDocuments": true,
  "hostedBaseUrl": "https://pbkware.github.io/fielded-text-ts/",
  "useTsLinkResolution": true,
  "navigationLinks": {
    "GitHub": "https://github.com/pbkware/fielded-text-ts",
    "Web NPM": "https://www.npmjs.com/package/@pbkware/fielded-text-web",
    "Node NPM": "https://www.npmjs.com/package/@pbkware/fielded-text-node"
    // "Sponsors": "https://pbkware.github.io/fielded-text-web/Overview/Sponsors/",
  }
}
